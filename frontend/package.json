{
  "name": "keti4-workbench-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:fast": "vite build",
    "gen:types": "json2ts -i ../backend/app/spec/spec.schema.json -o src/types/spec.generated.ts --bannerComment \"/* 由 backend/app/spec/spec.schema.json 生成，请勿手改（npm run gen:types） */\"",
    "e2e": "node ../scripts/e2e_demo.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "echarts": "^5.5.1",
    "element-plus": "^2.8.8",
    "highlight.js": "^11.10.0",
    "katex": "^0.16.11",
    "pinia": "^2.2.6",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.4",
    "json-schema-to-typescript": "^15.0.2",
    "playwright": "^1.48.2",
    "typescript": "~5.6.3",
    "vite": "^5.4.10",
    "vue-tsc": "^2.1.10"
  }
}
