# 复制为 .env 后按需修改；留空表示未配置
# 建模引擎：demo = 离线演示规则引擎；openai = OpenAI 兼容接口（本地 Qwen 用 vLLM 起服务）
LLM_MODE=demo
LLM_BASE_URL=http://127.0.0.1:8001/v1
LLM_MODEL=Qwen3-30B-A3B
LLM_API_KEY=

# 动态建模与去幻觉方法（动态建模 / 去幻觉）接口：POST {METHOD_ENDPOINT}/parse 与 /check；空 = 未接入
METHOD_ENDPOINT=

# 课题 3 风险评估接口：空 = 本地规则模拟
RISK_ENDPOINT=

# 求解：builtin（内置 HiGHS，直流近似 OTS，默认）| mock | import | external
SOLVER_MODE=builtin
# external 模式下执行的命令，占位符 {spec} {dir} {out}
# 例：python solve.py --spec {spec} --snapshots {dir} --out {out}
SOLVER_CMD=

# 断面目录（只读）
SNAPSHOT_DIR=./data/snapshots
