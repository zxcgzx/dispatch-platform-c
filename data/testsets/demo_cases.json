        "delta_pi": [
          {
            "target": "G237",
            "param": "PMAX",
            "direction": "decrease"
          }
        ],
        "structural": []
      }
    },
    {
      "id": "D5",
      "instruction": "母线 43 负荷提高 10%，开关操作不超过 2 次。",
      "expected_level": "L3",
      "expected": {
        "delta_pi": [
          {
            "target": "B43",
            "param": "PD",
            "operation": "scale",
            "value": 1.1,
            "periods": []
          }
        ],
        "structural": [
          {
            "op_id": "switching_limit_per_period",
            "params": {
              "k": 2
            }
          }
        ]
      }
    },
    {
      "id": "D6",
      "instruction": "由 L428、L429 组成的断面，有功限额设为 300 MW。",
      "expected_level": "L3",
      "expected": {
        "delta_pi": [],
        "structural": [
          {
            "op_id": "section_limit",
            "params": {
              "branches": [
                "L428",
                "L429"
              ],
              "limit_mw": 300
            }
          }
        ]
      }
    },
    {
      "id": "D7",
      "instruction": "高温，220kV 线路 L155 热稳限额下降，要求满足 N−1，尽量少动开关。",
      "expected_level": "L4",
      "expected": {
        "delta_pi": [
          {
            "target": "L155",
            "param": "RATE_A",
            "direction": "decrease"
          }
        ],
        "structural": [
          {
            "op_id": "switching_penalty",
            "params": {}
          }
        ]
      }
    },
    {
