        "delta_pi": [
          {
            "target": "L155",
            "param": "RATE_A",
            "direction": "decrease"
          }
        ],
        "structural": []
      }
    },
    {
      "id": "D4",
      "instruction": "母线 314 上的机组近期出力受限。",
      "expected_level": "L2",
