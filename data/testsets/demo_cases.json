{
  "name": "内置演示用例 D1–D10（单时段断面）",
  "description": "断面是单时段；有多个断面时按时刻组成多时段窗口。多时段写法见 demo_cases_multiperiod.json。",
  "cases": [
    {
      "id": "D1",
      "instruction": "母线 43 的有功负荷提高 20%。",
      "expected_level": "L1",
      "expected": {
        "delta_pi": [
          {
            "target": "B43",
            "param": "PD",
            "operation": "scale",
            "value": 1.2,
            "periods": []
          }
        ],
        "structural": []
      }
    },
    {
      "id": "D2",
      "instruction": "110kV 线路 L376（54–359）检修停运。",
      "expected_level": "L1",
      "expected": {
        "delta_pi": [
          {
            "target": "L376",
            "param": "BR_STATUS",
            "operation": "set",
            "value": 0,
            "periods": []
          }
        ],
        "structural": []
      },
      "expected_findings": [
        "I203"
      ],
      "forbidden_findings": [
        "W206"
      ]
    },
    {
      "id": "D3",
      "instruction": "持续高温，220kV 线路 L155（174–172）热稳能力下降。",
      "expected_level": "L2",
